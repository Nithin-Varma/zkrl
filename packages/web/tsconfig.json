{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "./.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "../../node_modules",
    "**/node_modules/**",
    "../../node_modules/.pnpm/@anon-aadhaar+core@*/node_modules/@anon-aadhaar/core/src/**"
  ]
}
